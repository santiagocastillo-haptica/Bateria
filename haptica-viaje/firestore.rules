        'P022': 'LLAVE-CO-02',
        'P023': 'LLAVE-CO-02',
        'P024': 'LLAVE-CO-02',
        'P025': 'LLAVE-CO-02',
        'P026': 'LLAVE-CO-02',
        'P027': 'LLAVE-CO-02',
        'P028': 'LLAVE-MX-01',
        'P029': 'LLAVE-MX-01',
        'P030': 'LLAVE-MX-01',
        'P031': 'LLAVE-MX-01',
        'P032': 'LLAVE-MX-01',
        'P033': 'LLAVE-MX-01',
        'P034': 'LLAVE-MX-01',
        'P035': 'LLAVE-MX-01',
        'P036': 'LLAVE-MX-02',
        'P037': 'LLAVE-MX-02',
        'P038': 'LLAVE-MX-02',
        'P039': 'LLAVE-MX-02',
        'P040': 'LLAVE-MX-02',
        'P041': 'LLAVE-MX-02',
        'P042': 'LLAVE-MX-02',
        'P043': 'LLAVE-MX-02',
        'P044': 'LLAVE-MX-03',
        'P045': 'LLAVE-MX-03',
        'P046': 'LLAVE-MX-03',
        'P047': 'LLAVE-MX-03',
        'P048': 'LLAVE-MX-03',
        'P049': 'LLAVE-MX-03',
        'P050': 'LLAVE-MX-03',
        'P051': 'LLAVE-MX-04',
        'P052': 'LLAVE-MX-04',
        'P053': 'LLAVE-MX-04',
        'P054': 'LLAVE-MX-04',
        'P055': 'LLAVE-MX-04',
        'P056': 'LLAVE-MX-04',
        'P057': 'LLAVE-MX-04',
        'P058': 'LLAVE-MX-04',
        'P059': 'LLAVE-MX-04',
        'P060': 'LLAVE-CL-01',
        'P061': 'LLAVE-CL-01',
        'P062': 'LLAVE-CL-01',
        'P063': 'LLAVE-CL-01',
        'P064': 'LLAVE-CL-02',
        'P065': 'LLAVE-CL-02',
        'P066': 'LLAVE-CL-02',
        'P067': 'LLAVE-CL-02',
        'P068': 'LLAVE-CL-02',
        'P069': 'LLAVE-CL-02',
        'P070': 'LLAVE-CL-02',
        'P071': 'LLAVE-CL-02',
        'P072': 'LLAVE-CL-02',
        'P073': 'LLAVE-CL-03',
        'P074': 'LLAVE-CL-03',
        'P075': 'LLAVE-CL-03',
