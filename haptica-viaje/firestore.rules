        'P134': 'LLAVE-CO2-02',
        'P135': 'LLAVE-CO2-02',
        'P136': 'LLAVE-CO2-02',
        'P137': 'LLAVE-CO2-02',
        'P138': 'LLAVE-CO2-02',
        'P139': 'LLAVE-CO2-02',
