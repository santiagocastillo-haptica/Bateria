# Configuración de Firebase (Vite expone solo variables con prefijo VITE_).
# Copia este archivo como `.env.local` y pega los valores del proyecto REAL de Háptica.
# Consola Firebase → Configuración del proyecto (⚙️) → Tus apps → app Web (</>) → Config.
#
# Mientras estas variables estén vacías, la app corre en MODO DEMO (localStorage),
# lo que permite recorrer y demostrar la experiencia sin backend.
# NO subir `.env.local` al repositorio (ya está en .gitignore).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Modo de la app: review (preparación) | production (lanzamiento real)
VITE_APP_MODE=review
